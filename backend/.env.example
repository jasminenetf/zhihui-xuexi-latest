# 智学工坊 backend environment example
# Copy this file to backend/.env or project-root .env and fill real secrets locally.

# App
APP_NAME=intelligent-learning-agent
APP_ENV=development
BACKEND_PORT=8010

# Database
# Fast local mode uses SQLite by default.
DATABASE_URL=sqlite:///./data/app.db
# Docker Compose PostgreSQL example:
# DATABASE_URL=postgresql://learning_user:learning_password@127.0.0.1:5432/intelligent_learning
POSTGRES_DB=intelligent_learning
POSTGRES_USER=learning_user
POSTGRES_PASSWORD=learning_password
POSTGRES_PORT=5432

# JWT
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ChromaDB / RAG
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=course_chunks

# Embedding
EMBEDDING_PROVIDER=hash_mock
EMBEDDING_DIM=384
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# LLM provider: deepseek | spark | mock
LLM_PROVIDER=deepseek
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60

# iFlytek Spark
SPARK_ENABLED=false
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/x2
SPARK_API_KEY=
SPARK_API_PASSWORD=
SPARK_MODEL=spark-x
SPARK_TIMEOUT_SECONDS=30
SPARK_FALLBACK_PROVIDER=deepseek

# Virtual Human / Digital Avatar
VIRTUAL_HUMAN_ENABLED=false
XFYUN_VH_API_KEY=
XFYUN_VH_API_SECRET=
XFYUN_VH_BASE_URL=https://vms.cn-huadong-1.xf-yun.com
XFYUN_VH_AVATAR_ID=
XFYUN_VH_VOICE_ID=x4_xiaoxuan
VH_TIMEOUT_SECONDS=30

# Admin panel
ADMIN_ENABLED=false

# File upload and generated resources
FILE_UPLOAD_MAX_MB=80
GENERATED_DIR=./data/generated

# Future deployment extensions / Docker Compose services
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=learning-resources
S3_REGION=auto
